        <mxCell id="okPOB5ewjbJ5I83FCLKM-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;4. Identify Core Entity:&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;li data-section-id=&quot;1ttqfjw&quot; data-start=&quot;407&quot; data-end=&quot;441&quot;&gt;&lt;strong data-start=&quot;409&quot; data-end=&quot;417&quot;&gt;User&lt;/strong&gt; → userId, name, email&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-section-id=&quot;1m8v57c&quot; data-start=&quot;442&quot; data-end=&quot;501&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;444&quot; data-end=&quot;453&quot;&gt;Event&lt;/strong&gt; → eventId, title, date, location, description&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-section-id=&quot;kiu4h9&quot; data-start=&quot;502&quot; data-end=&quot;541&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;504&quot; data-end=&quot;513&quot;&gt;Venue&lt;/strong&gt; → venueId, name, location&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-section-id=&quot;18go5s2&quot; data-start=&quot;542&quot; data-end=&quot;580&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;544&quot; data-end=&quot;552&quot;&gt;Seat&lt;/strong&gt; → seatId, eventId, status&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-section-id=&quot;proghe&quot; data-start=&quot;581&quot; data-end=&quot;633&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;583&quot; data-end=&quot;594&quot;&gt;Booking&lt;/strong&gt; → bookingId, userId, eventId, status&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-section-id=&quot;i5p09z&quot; data-start=&quot;634&quot; data-end=&quot;688&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;636&quot; data-end=&quot;647&quot;&gt;Payment&lt;/strong&gt; → paymentId, bookingId, amount, status&lt;/li&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
