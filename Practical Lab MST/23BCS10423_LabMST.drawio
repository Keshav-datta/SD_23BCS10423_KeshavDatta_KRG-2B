        <mxCell id="Yey6DWV75Pxvr3Z8La9T-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 15px;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Practical Lab MST&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;Times New Roman&quot;&gt;AIM: Design Whatsapp application&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Functional Requirements&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p&gt;&lt;/p&gt;&lt;div style=&quot;&quot;&gt;&lt;ol data-start=&quot;235&quot; data-end=&quot;577&quot;&gt;&lt;li data-start=&quot;235&quot; data-end=&quot;288&quot;&gt;&lt;p data-start=&quot;238&quot; data-end=&quot;288&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;238&quot; data-end=&quot;286&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Client should be able to register and login.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;289&quot; data-end=&quot;341&quot;&gt;&lt;p data-start=&quot;292&quot; data-end=&quot;341&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;292&quot; data-end=&quot;339&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should support one-to-one messaging.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;342&quot; data-end=&quot;389&quot;&gt;&lt;p data-start=&quot;345&quot; data-end=&quot;389&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;345&quot; data-end=&quot;387&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should support group messaging.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;390&quot; data-end=&quot;451&quot;&gt;&lt;p data-start=&quot;393&quot; data-end=&quot;451&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;393&quot; data-end=&quot;449&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should allow sending text and media messages.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;452&quot; data-end=&quot;500&quot;&gt;&lt;p data-start=&quot;455&quot; data-end=&quot;500&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;455&quot; data-end=&quot;498&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should preserve message history.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;501&quot; data-end=&quot;577&quot;&gt;&lt;p data-start=&quot;504&quot; data-end=&quot;577&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;504&quot; data-end=&quot;577&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Client should be able to see message delivery status (read receipts).&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;&quot;&gt;Non-Functional Requirements&lt;/font&gt;&lt;/div&gt;&lt;ol data-start=&quot;615&quot; data-end=&quot;932&quot;&gt;&lt;li data-start=&quot;615&quot; data-end=&quot;705&quot;&gt;&lt;p data-start=&quot;618&quot; data-end=&quot;705&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;618&quot; data-end=&quot;703&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should support large scale (up to billions of users and messages per day).&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;706&quot; data-end=&quot;794&quot;&gt;&lt;p data-start=&quot;709&quot; data-end=&quot;794&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;709&quot; data-end=&quot;792&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should ensure high availability with eventual consistency (CAP theorem).&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;795&quot; data-end=&quot;870&quot;&gt;&lt;p data-start=&quot;798&quot; data-end=&quot;870&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;798&quot; data-end=&quot;868&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should maintain low latency (~200–300 ms message delivery).&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;871&quot; data-end=&quot;932&quot;&gt;&lt;p data-start=&quot;874&quot; data-end=&quot;932&quot; style=&quot;text-align: justify;&quot;&gt;&lt;strong data-start=&quot;874&quot; data-end=&quot;932&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;System should be highly reliable with no message loss&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
